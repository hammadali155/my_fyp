# Jawhar Backend Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# --- Application ---
APP_NAME="Jawhar API"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL="INFO"
LOG_JSON=false

# --- Database (required) ---
# Local dev (SQLite, zero setup):
DATABASE_URL="sqlite+aiosqlite:///./jawhar.db"
# Production (Supabase PostgreSQL — get from Supabase Settings → Database):
# DATABASE_URL="postgresql+asyncpg://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Security & Authentication (required) ---
JWT_SECRET="jawhar-development-secret-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Add your frontend domain(s) here. "*" allows all (fine for dev/FYP demo).
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8081","*"]

# --- Gemini (AI tutor / i'rab explanations) ---
# Leave empty to disable AI tutor features.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=0.5

# --- AI tutor limits ---
TUTOR_CONTEXT_MAX_CHARS=6000
TUTOR_DAILY_MESSAGE_LIMIT=40
TUTOR_HISTORY_MAX_TOKENS=2000

# --- Farasa sidecar (Nahw free-text parsing) ---
# Not deployed yet — leave unset.
FARASA_URL="http://localhost:8765"
FARASA_TIMEOUT_SECONDS=10
