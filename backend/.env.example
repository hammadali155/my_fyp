# Jawhar Backend Configuration
APP_NAME="Jawhar API"
APP_VERSION="0.1.0"
DEBUG=true

# Database (default is SQLite for local zero-dependency dev)
DATABASE_URL="sqlite+aiosqlite:///./jawhar.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://jawhar_user:jawhar_pass@localhost:5432/jawhar"

# Security & Authentication
JWT_SECRET="jawhar-development-secret-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging & Observability
LOG_LEVEL="INFO"
LOG_JSON=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8081","*"]

# Gemini (AI tutor / i'rab explanations). Leave the key empty to disable.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=0.5

# Farasa sidecar (Nahw free-text parsing). Not deployed yet: leave unset.
FARASA_URL="http://localhost:8765"
FARASA_TIMEOUT_SECONDS=10
